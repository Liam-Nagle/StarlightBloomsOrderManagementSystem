# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=starlight_blooms

# Application Configuration
ENVIRONMENT=development
PORT=8000

# CORS Configuration
# For development: http://localhost:5500,http://127.0.0.1:5500
# For production: https://yourusername.github.io
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Wix Integration Configuration
WIX_API_KEY=your_secure_api_key_here
WIX_BASE_URL=https://starlightblooms.wixsite.com/starlight-blooms-by/_functions
